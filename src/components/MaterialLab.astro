---
---
<section class="lab" id="lab" aria-label="材质实验">
  <div class="lab-head">
    <h2>材质实验</h2>
    <span id="render-status">材质球</span>
  </div>
  <div class="lab-stage">
    <svg class="lab-fallback" viewBox="0 0 600 380" aria-label="灰度材质球预览" role="img"><defs><radialGradient id="sphere" cx="30%" cy="25%"><stop stop-color="#fff"/><stop offset=".4" stop-color="#aaa"/><stop offset=".8" stop-color="#333"/><stop offset="1" stop-color="#111"/></radialGradient></defs><circle cx="300" cy="190" r="118" fill="url(#sphere)"/></svg>
    <canvas id="material-canvas" aria-label="实时材质球，可拖动旋转视角"></canvas>
  </div>
  <div class="lab-controls">
    <div class="material-modes" role="group" aria-label="材质模式">
      <button data-mode="0" class="selected" aria-pressed="true">黏土</button>
      <button data-mode="1" aria-pressed="false">金属</button>
      <button data-mode="2" aria-pressed="false">线框</button>
    </div>
    <label class="roughness-control" for="roughness">
      粗糙度 <input id="roughness" type="range" min="0.05" max="0.95" step="0.01" value="0.38" />
      <output id="roughness-value">0.38</output>
    </label>
  </div>
</section>
<script>
  import { initMaterialLab } from '../scripts/material';
  initMaterialLab();
</script>
