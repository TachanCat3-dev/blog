---
import Base from '../layouts/Base.astro';
import MaterialLab from '../components/MaterialLab.astro';
import { getNotes, url, dateText } from '../lib/notes';
const notes = await getNotes();
const tags = [...new Set(notes.flatMap((note) => note.data.tags))];
---
<Base active="notes">
  <section class="intro">
    <h1>在艺术与技术之间，持续探索。</h1>
    <p>把看见的效果，变成理解的原理。这里记录渲染、材质与工具开发中的学习和实践。</p>
  </section>

  <section class="notes" id="notes" aria-label="学习笔记">
    <div class="section-title">
      <h2>学习笔记</h2>
      <span>共 {notes.length} 篇</span>
    </div>
    <div class="toolbar">
      <div class="filters" role="group" aria-label="按主题筛选">
        <button class="active" data-filter="全部" aria-pressed="true">全部</button>
        {tags.map((tag) => <button data-filter={tag} aria-pressed="false">{tag}</button>)}
      </div>
      <label class="search-label">
        <span aria-hidden="true">⌕</span>
        <input id="note-search" type="search" placeholder="搜索笔记" aria-label="搜索笔记" autocomplete="off" />
      </label>
    </div>
    <ul class="note-list">
      {notes.map((note) => (
        <li class="note-item" data-tags={JSON.stringify(note.data.tags)} data-search={`${note.data.title} ${note.data.summary} ${note.data.tags.join(' ')}`}>
          <a class="note-link" href={url(`posts/${note.id}/`)}>
            <h3>{note.data.title}</h3>
            <p>{note.data.summary}</p>
            <div class="note-meta">
              <span><time datetime={note.data.date.toISOString()}>{dateText(note.data.date)}</time></span>
              {note.data.tags.length > 0 && <span>{note.data.tags.join(' / ')}</span>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty-state" hidden role="status">没有匹配的笔记，换个关键词试试。</p>
  </section>

  <MaterialLab />
</Base>
<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.note-item')];
  const search = document.querySelector<HTMLInputElement>('#note-search')!;
  const empty = document.querySelector<HTMLElement>('.empty-state')!;
  let selected = '全部';
  function filterNotes() {
    const query = search.value.trim().toLocaleLowerCase();
    let count = 0;
    items.forEach((item) => {
      const tags: string[] = JSON.parse(item.dataset.tags || '[]');
      const visible = (selected === '全部' || tags.includes(selected)) && (item.dataset.search || '').toLocaleLowerCase().includes(query);
      item.hidden = !visible;
      if (visible) count++;
    });
    empty.hidden = count !== 0;
  }
  filters.forEach((button) => button.addEventListener('click', () => {
    selected = button.dataset.filter || '全部';
    filters.forEach((item) => { item.classList.toggle('active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
    filterNotes();
  }));
  search.addEventListener('input', filterNotes);
</script>
