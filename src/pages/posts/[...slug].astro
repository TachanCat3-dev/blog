---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, url, dateText } from '../../lib/notes';
export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note,index) => ({ params: { slug: note.id }, props: { note, older: notes[index+1], newer: notes[index-1] } }));
}
const { note, older, newer } = Astro.props;
const { Content } = await render(note);
const minutes = Math.max(1, Math.ceil((note.body?.length || 0)/500));
---
<Base title={note.data.title} description={note.data.summary} active="notes">
  <article class="article">
    <a class="back-link" href={url()}>← 返回笔记列表</a>
    <header class="article-header">
      <h1>{note.data.title}</h1>
      {note.data.summary && <p class="article-summary">{note.data.summary}</p>}
      <div class="article-meta">
        <span><time datetime={note.data.date.toISOString()}>{dateText(note.data.date)}</time></span>
        {note.data.tags.length > 0 && <span>{note.data.tags.join(' / ')}</span>}
        <span>约 {minutes} 分钟</span>
      </div>
    </header>
    <div class="prose"><Content /></div>
    <nav class="article-navigation" aria-label="相邻文章">
      <div>{older && <a href={url(`posts/${older.id}/`)}><span>上一篇</span>{older.data.title}</a>}</div>
      <div>{newer && <a href={url(`posts/${newer.id}/`)}><span>下一篇</span>{newer.data.title}</a>}</div>
    </nav>
  </article>
</Base>
